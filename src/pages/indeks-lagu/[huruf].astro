---
import Layout from '../../layouts/Layout.astro';
import { getAllSongs } from '../../lib/strapi';

export async function getStaticPaths() {
  const allSongs = await getAllSongs();

  const alphabets = ['#', ...Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))];

  // Hitung jumlah lagu per huruf
  const countsMap = new Map<string, number>();
  allSongs.forEach((song: any) => {
    const title = (song.Title || song.title || '').trim().toUpperCase();
    if (!title) return;
    const firstChar = title[0];
    const key = /^[A-Z]/.test(firstChar) ? firstChar : '#';
    countsMap.set(key, (countsMap.get(key) || 0) + 1);
  });

  const letterCounts = alphabets.map(l => ({
    letter: l,
    slug: l === '#' ? '0-9' : l.toLowerCase(),
    count: countsMap.get(l) || 0
  }));

  const paths: any[] = [];

  alphabets.forEach((letter) => {
    const targetLetter = letter.toUpperCase();
    const songsForLetter = allSongs.filter((song: any) => {
      const title = (song.Title || song.title || '').trim().toUpperCase();
      if (!title) return false;
      if (targetLetter === '#') {
        return !/^[A-Z]/.test(title);
      }
      return title.startsWith(targetLetter);
    });

    const slugLower = letter === '#' ? '0-9' : letter.toLowerCase();
    const slugUpper = letter === '#' ? '0-9' : letter.toUpperCase();

    // Sediakan path huruf kecil dan huruf besar (/indeks-lagu/p dan /indeks-lagu/P)
    paths.push({
      params: { huruf: slugLower },
      props: { letter, songs: songsForLetter, letterCounts }
    });

    if (slugLower !== slugUpper) {
      paths.push({
        params: { huruf: slugUpper },
        props: { letter, songs: songsForLetter, letterCounts }
      });
    }
  });

  return paths;
}

const { letter, songs, letterCounts } = Astro.props;

// Format views count
const formatViews = (num: any) => {
  const count = Number(num) || 0;
  if (count >= 1000000) return (count / 1000000).toFixed(1) + 'M';
  if (count >= 1000) return (count / 1000).toFixed(1) + 'K';
  return count.toString();
};
---

<Layout title={`Lagu Berawalan Huruf ${letter} (${songs.length}) | Gendang Karo`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-10 space-y-10">
    
    <!-- TOP NAVIGATION & BREADCRUMBS -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <a
        href="/indeks-lagu"
        class="inline-flex items-center gap-2 text-xs font-bold text-red-400 hover:text-red-300 font-['Outfit'] uppercase tracking-wider transition-colors"
      >
        <span>← Kembali ke Semua Abjad</span>
      </a>
      <span class="text-xs text-neutral-400 font-medium">
        Koleksi Huruf {letter}
      </span>
    </div>

    <!-- QUICK ALPHABET BAR (SLIDER/GRID) -->
    <div class="space-y-2">
      <div class="flex items-center overflow-x-auto pb-2 gap-1.5 scrollbar-thin">
        {letterCounts.map((item: any) => {
          const isCurrent = item.letter.toUpperCase() === letter.toUpperCase();
          return (
            <a
              href={`/indeks-lagu/${item.slug}`}
              class={`px-3 py-1.5 rounded-lg text-xs font-bold font-['Outfit'] transition-all flex items-center gap-1 flex-shrink-0 ${
                isCurrent
                  ? 'bg-gradient-to-r from-red-600 to-amber-700 text-white shadow-md'
                  : 'glass-panel text-neutral-400 hover:text-white hover:border-red-600/40'
              }`}
            >
              <span>{item.letter}</span>
              {item.count > 0 && (
                <span class={`text-[9px] px-1 py-0.2 rounded-full ${isCurrent ? 'bg-black/30 text-white' : 'bg-red-950/70 text-red-400'}`}>
                  {item.count}
                </span>
              )}
            </a>
          );
        })}
      </div>
    </div>

    <!-- HEADER TITLE FOR CURRENT LETTER -->
    <div class="space-y-2">
      <div class="flex items-center gap-3">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white font-['Outfit'] uppercase tracking-tight">
          Lagu Berawalan Huruf <span class="text-red-500">"{letter}"</span>
        </h1>
        <span class="text-xs font-bold px-3 py-1 rounded-full bg-red-950/70 text-red-300 border border-red-700/40 font-['Outfit']">
          {songs.length} Lagu
        </span>
      </div>
      <p class="text-neutral-400 text-xs sm:text-sm font-medium">
        Daftar seluruh judul lagu daerah Karo yang diawali huruf {letter}.
      </p>
    </div>

    <!-- SONG LIST -->
    <div class="space-y-3 pt-2">
      {songs.length > 0 ? (
        songs.map((song: any, index: number) => {
          const songSlug = song.slug || song.documentId;
          const artistName = (song.penyanyis && song.penyanyis.length > 0)
            ? song.penyanyis.map((p: any) => p.name).join(', ')
            : (song.penyanyi?.name || 'Artis Tidak Diketahui');
          const title = song.Title || song.title || 'Tanpa Judul';
          const views = song.views || 0;

          return (
            <a
              href={`/lagu/${songSlug}`}
              class="group flex items-center justify-between p-4 sm:p-5 rounded-2xl glass-panel hover:border-red-600/50 hover:bg-[#181620] hover:-translate-y-1 transition-all duration-200 shadow-md"
            >
              <!-- Sisi Kiri: Cover & Info Lagu -->
              <div class="flex items-center space-x-4 sm:space-x-5 min-w-0">
                <div class="w-12 h-12 rounded-xl bg-neutral-900 border border-white/10 flex items-center justify-center text-red-500 font-bold text-xl group-hover:bg-red-700 group-hover:text-white transition-all font-['Outfit'] flex-shrink-0">
                  🎵
                </div>
                <div class="truncate">
                  <h2 class="text-base sm:text-lg font-bold text-white group-hover:text-red-400 font-['Outfit'] transition-colors truncate">
                    {title}
                  </h2>
                  <p class="text-xs sm:text-sm text-neutral-400 font-medium mt-0.5 truncate">
                    {artistName}
                  </p>
                </div>
              </div>

              <!-- Sisi Kanan: Views & Tombol Buka -->
              <div class="flex items-center space-x-3 sm:space-x-5 flex-shrink-0 pl-3">
                <span class="text-xs text-neutral-400 group-hover:text-white font-medium">
                  👁️ {formatViews(views)} views
                </span>
                <span class="text-xs font-bold uppercase tracking-wider px-3.5 py-1.5 rounded-lg bg-red-950/70 text-red-300 border border-red-700/40 group-hover:bg-red-700 group-hover:text-white transition-all font-['Outfit']">
                  Buka Lirik →
                </span>
              </div>
            </a>
          );
        })
      ) : (
        <div class="py-20 text-center glass-panel rounded-2xl space-y-3">
          <div class="text-4xl text-neutral-600">📂</div>
          <h2 class="text-xl font-bold text-white font-['Outfit']">
            Belum ada lagu berawalan huruf "{letter}"
          </h2>
          <p class="text-xs text-neutral-400 max-w-md mx-auto leading-relaxed">
            Database saat ini belum memiliki lagu Karo yang diawali huruf {letter}. Silakan pilih abjad lain pada navigasi di atas.
          </p>
          <div class="pt-4">
            <a
              href="/indeks-lagu"
              class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-red-700 hover:bg-red-600 text-white text-xs font-bold tracking-wide uppercase transition-all"
            >
              Lihat Abjad Lainnya
            </a>
          </div>
        </div>
      )}
    </div>

  </div>
</Layout>
