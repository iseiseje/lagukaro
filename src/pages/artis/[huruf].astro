---
export function getStaticPaths() {
  const alphabets = [
    '0-9',
    ...Array.from({ length: 26 }, (_, i) => String.fromCharCode(97 + i)),
    ...Array.from({ length: 26 }, (_, i) => String.fromCharCode(65 + i))
  ];
  return alphabets.map(h => ({ params: { huruf: h } }));
}

const { huruf } = Astro.params;
return Astro.redirect(`/indeks-lagu/${huruf.toLowerCase()}`);
