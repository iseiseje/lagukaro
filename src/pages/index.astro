---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';

const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL || 'https://api.lagukaro.id';

const pageParam = Astro.url.searchParams.get('page') || '1';

let songs: any[] = [];
let pagination = { page: 1, pageCount: 1 };

try {
  const res = await fetch(`${STRAPI_URL}/api/lagus?populate=*&pagination[pageSize]=50&pagination[page]=${pageParam}`);
  if (!res.ok) {
    throw new Error(`API error: ${res.status} ${res.statusText}`);
  }
  const data = await res.json();
  songs = data.data || [];
  pagination = data.meta?.pagination || { page: 1, pageCount: 1 };
} catch (error) {
  console.error("Gagal mengambil data lagu dari Strapi API:", error);
}

// Helper ekstraksi nama penyanyi (Mendukung Many-to-Many penyanyis & fallback singular)
const getArtistNames = (song: any): string => {
  if (song?.penyanyis && Array.isArray(song.penyanyis) && song.penyanyis.length > 0) {
    return song.penyanyis.map((p: any) => p.name || p.nama).filter(Boolean).join(', ');
  }
  if (song?.penyanyi?.name) {
    return song.penyanyi.name;
  }
  return 'Artis Tidak Diketahui';
};

// Normalisasi views dari Strapi agar default ke 0 jika kosong
songs.forEach(song => {
  song.views = Number(song.views) || 0;
});

// Sortir manual di JavaScript agar aman meski views bernilai null/0
songs.sort((a, b) => (Number(b.views) || 0) - (Number(a.views) || 0));

// Format tampilan angka views
const formatViews = (num: any) => {
  const count = Number(num) || 0;
  if (count >= 1000000) return (count / 1000000).toFixed(1) + 'M';
  if (count >= 1000) return (count / 1000).toFixed(1) + 'K';
  return count.toString();
};
---

<Layout title="Lagu Karo Trending & Lirik Terlengkap">
  
  <!-- HERO SECTION -->
  <section class="relative py-16 sm:py-20 px-4 sm:px-6">
    <!-- Ambient Subtle Brand Glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-[var(--brand-primary)]/10 dark:bg-[var(--brand-primary)]/15 blur-[130px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto text-center space-y-6 relative z-20">
      
      <!-- Cultural Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[var(--brand-secondary)]/20 border border-[var(--brand-secondary)]/40 text-[var(--brand-secondary-dark)] dark:text-[#20B2AA] text-xs font-semibold tracking-wide uppercase font-['Outfit'] shadow-xs">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--brand-secondary)] animate-pulse"></span>
        Ensiklopedia Musik & Budaya Karo
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-[var(--text-main)] font-['Outfit'] leading-[1.15]">
        Temukan Lirik, Arti, & <br class="hidden sm:inline" />
        <span class="text-[var(--brand-primary)]">
          Makna Lagu Karo
        </span>
      </h1>

      <p class="text-[var(--text-muted)] text-sm sm:text-base max-w-xl mx-auto font-medium leading-relaxed">
        Pustaka lirik lagu daerah Karo terlengkap dan terpercaya. Dilengkapi dengan terjemahan bahasa Indonesia serta analisis makna lagu.
      </p>

      <!-- Live Search Bar Wrapper -->
      <div class="pt-4 max-w-2xl mx-auto relative z-30 text-left">
        <SearchBar />
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT CONTAINER -->
  <section id="trending" class="max-w-5xl mx-auto px-4 sm:px-6 py-8 space-y-12 relative z-10 scroll-mt-20">

    <!-- TRENDING SECTION HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-[var(--border-color)] pb-4 gap-3">
      <div class="space-y-1">
        <div class="flex items-center gap-2.5">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-[var(--text-main)] uppercase font-['Outfit']">
            LAGU TRENDING
          </h2>
          <span class="text-[11px] font-bold bg-[var(--brand-secondary)]/20 text-[var(--brand-secondary-dark)] dark:text-[#20B2AA] border border-[var(--brand-secondary)]/30 px-2.5 py-0.5 rounded font-['Outfit'] tracking-wider uppercase">
            POPULER
          </span>
        </div>
        <p class="text-xs text-[var(--text-muted)] font-medium">Lagu Karo Paling Banyak Dicari & Didengar Saat Ini</p>
      </div>

      <div class="flex items-center gap-2 text-xs font-semibold">
        <span class="px-3 py-1 rounded-lg bg-[var(--brand-primary)]/15 text-[var(--brand-primary)] border border-[var(--brand-primary)]/30 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--brand-primary)] animate-pulse"></span>
          TRENDING SEKARANG
        </span>
      </div>
    </div>

    <!-- PROGRESSIVE TOP 10 TRENDING CARDS -->
    {songs.length > 0 ? (
      (() => {
        const top10 = songs.slice(0, 10);

        const getSongData = (song: any) => ({
          slug: song.slug || song.documentId,
          artist: getArtistNames(song),
          title: song.Title || song.title || 'Tanpa Judul',
          views: formatViews(song.views)
        });

        const getCardStyle = (rank: number) => {
          if (rank === 1) {
            return {
              padding: "p-4 sm:p-5",
              iconWrapper: "w-14 h-14 sm:w-16 sm:h-16 text-2xl sm:text-3xl rounded-xl",
              title: "text-lg sm:text-xl font-extrabold",
              artist: "text-sm sm:text-base font-semibold",
              hyphen: "text-sm font-bold",
              badge: "bg-[var(--brand-primary)] text-white font-extrabold text-xs px-2.5 py-0.5 shadow-xs",
              viewsText: "text-xs",
              arrowBtn: "w-10 h-10",
              arrowIcon: "w-5 h-5",
              cardClass: "glass-panel-glow rounded-2xl"
            };
          }
          if (rank === 2) {
            return {
              padding: "py-3 px-3.5 sm:py-3.5 sm:px-4",
              iconWrapper: "w-12 h-12 sm:w-13 sm:h-13 text-xl rounded-xl",
              title: "text-base sm:text-lg font-bold",
              artist: "text-xs sm:text-sm font-semibold",
              hyphen: "text-xs font-semibold",
              badge: "bg-[var(--brand-secondary)] text-white font-bold text-[11px] px-2 py-0.5 shadow-xs",
              viewsText: "text-[11px] sm:text-xs",
              arrowBtn: "w-8 h-8 sm:w-9 sm:h-9",
              arrowIcon: "w-4 h-4",
              cardClass: "glass-panel rounded-xl"
            };
          }
          if (rank === 3) {
            return {
              padding: "py-2.5 px-3 sm:py-3 sm:px-4",
              iconWrapper: "w-10 h-10 sm:w-11 sm:h-11 text-lg rounded-lg",
              title: "text-sm sm:text-base font-bold",
              artist: "text-xs sm:text-sm font-semibold",
              hyphen: "text-xs font-medium",
              badge: "bg-[var(--brand-accent)] text-neutral-900 font-bold text-[10px] sm:text-[11px] px-2 py-0.5 shadow-xs",
              viewsText: "text-[11px]",
              arrowBtn: "w-7 h-7 sm:w-8 sm:h-8",
              arrowIcon: "w-3.5 h-3.5",
              cardClass: "glass-panel rounded-xl"
            };
          }
          if (rank <= 6) {
            return {
              padding: "py-2 px-3 sm:py-2.5 sm:px-3.5",
              iconWrapper: "w-8 h-8 sm:w-9 sm:h-9 text-base rounded-md",
              title: "text-xs sm:text-sm font-semibold",
              artist: "text-[11px] sm:text-xs font-medium",
              hyphen: "text-xs font-normal",
              badge: "bg-neutral-800 text-white font-semibold text-[9px] sm:text-[10px] px-1.5 py-0.5",
              viewsText: "text-[10px] sm:text-[11px]",
              arrowBtn: "w-6 h-6 sm:w-7 sm:h-7",
              arrowIcon: "w-3 h-3 sm:w-3.5 sm:h-3.5",
              cardClass: "glass-panel rounded-lg"
            };
          }
          // Rank 7 to 10
          return {
            padding: "py-1.5 px-2.5 sm:py-2 sm:px-3",
            iconWrapper: "w-6 h-6 sm:w-7 sm:h-7 text-xs rounded",
            title: "text-xs font-medium",
            artist: "text-[10px] sm:text-[11px] font-normal",
            hyphen: "text-[10px]",
            badge: "bg-neutral-200 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 font-medium text-[9px] px-1.5 py-0.2",
            viewsText: "text-[10px]",
            arrowBtn: "w-5 h-5 sm:w-6 sm:h-6",
            arrowIcon: "w-2.5 h-2.5 sm:w-3 sm:h-3",
            cardClass: "glass-panel rounded-md"
          };
        };

        return (
          <div class="space-y-2 mb-8">
            {top10.map((song, idx) => {
              const s = getSongData(song);
              const rankNum = idx + 1;
              const style = getCardStyle(rankNum);

              return (
                <div class="perspective-1000">
                  <a
                    href={`/lagu/${s.slug}`}
                    class={`group block relative ${style.cardClass} ${style.padding} transition-all duration-200 hover:-translate-y-0.5`}
                  >
                    <div class="flex items-center justify-between gap-3">
                      <!-- Left: Artwork & Song Details -->
                      <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1">
                        <div class={`${style.iconWrapper} bg-[var(--brand-primary)] text-white flex items-center justify-center font-extrabold shadow-sm flex-shrink-0 group-hover:scale-105 transition-transform duration-200`}>
                          🎵
                        </div>
                        <div class="space-y-0.5 min-w-0 flex-1">
                          <!-- Top row: Trending Badge + Views -->
                          <div class="flex items-center gap-2">
                            <span class={`inline-flex items-center gap-1 uppercase tracking-wide font-['Outfit'] rounded ${style.badge}`}>
                              🔥 TRENDING #{rankNum}
                            </span>
                            <span class={`${style.viewsText} text-[var(--text-muted)] font-medium flex items-center gap-1`}>
                              <svg class="w-3 h-3 text-[var(--brand-primary)] inline flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                              </svg>
                              {s.views} Dilihat
                            </span>
                          </div>

                          <!-- Bottom row: Judul Lagu - Penyanyi (Horizontal) -->
                          <div class="flex flex-wrap sm:flex-nowrap items-baseline gap-x-2 gap-y-0.5 min-w-0">
                            <h3 class={`${style.title} text-[var(--text-main)] group-hover:text-[var(--brand-primary)] transition-colors leading-snug truncate font-['Outfit']`}>
                              {s.title}
                            </h3>
                            <span class={`text-[var(--text-subtle)] select-none ${style.hyphen}`}>-</span>
                            <p class={`${style.artist} text-[var(--text-muted)] truncate`}>
                              {s.artist}
                            </p>
                          </div>
                        </div>
                      </div>

                      <!-- Right: Arrow hover indicator -->
                      <div class="flex items-center flex-shrink-0 pr-1">
                        <div class={`${style.arrowBtn} rounded-full bg-neutral-100 dark:bg-white/5 border border-[var(--border-color)] flex items-center justify-center text-[var(--text-muted)] group-hover:bg-[var(--brand-primary)] group-hover:text-white group-hover:border-[var(--brand-primary)] group-hover:translate-x-1 transition-all duration-200 shadow-xs`}>
                          <svg class={style.arrowIcon} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        );
      })()
    ) : (
      <div class="py-12 text-center text-[var(--text-muted)] text-sm glass-panel rounded-xl">
        Belum ada lagu yang dipublikasikan di database.
      </div>
    )}

    <!-- SPOTLIGHT KOMPOSER & ARTIS POPULER KARO SECTION -->
    <div class="pt-10 border-t border-[var(--border-color)]">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div class="space-y-1">
          <span class="text-xs font-bold tracking-wider text-[var(--brand-secondary)] uppercase font-['Outfit']">SPOTLIGHT SENIMAN & KOMPOSER</span>
          <h3 class="text-xl sm:text-2xl font-extrabold text-[var(--text-main)] uppercase font-['Outfit']">Musisi & Legenda Karo</h3>
          <p class="text-xs text-[var(--text-muted)] max-w-md">Jelajahi karya komposer, penyanyi, dan maestro musik daerah Karo.</p>
        </div>
        <a
          href="/indeks-lagu"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-[var(--brand-primary)] hover:underline font-['Outfit'] uppercase tracking-wide hover:translate-x-1 transition-all"
        >
          <span>Lihat Indeks Lagu (A-Z)</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="group glass-panel p-5 rounded-xl space-y-3 hover:border-[var(--brand-primary)]/50 hover:-translate-y-1 transition-all duration-200">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-[var(--brand-primary)] text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-sm group-hover:scale-105 transition-transform">
              DD
            </div>
            <div>
              <h4 class="font-bold text-[var(--text-main)] text-sm group-hover:text-[var(--brand-primary)] transition-colors font-['Outfit']">Djaga Depari</h4>
              <span class="text-[10px] font-semibold text-[var(--brand-secondary-dark)] dark:text-[#20B2AA] bg-[var(--brand-secondary)]/20 px-2 py-0.5 rounded border border-[var(--brand-secondary)]/30">Legenda Komposer</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed font-normal">
            Pencipta lagu-lagu legendaris Karo seperti Piso Surit, Erkata Bedil, dan Morah-Morah.
          </p>
        </div>

        <div class="group glass-panel p-5 rounded-xl space-y-3 hover:border-[var(--brand-primary)]/50 hover:-translate-y-1 transition-all duration-200">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-[var(--brand-primary)] text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-sm group-hover:scale-105 transition-transform">
              UG
            </div>
            <div>
              <h4 class="font-bold text-[var(--text-main)] text-sm group-hover:text-[var(--brand-primary)] transition-colors font-['Outfit']">Usman Ginting</h4>
              <span class="text-[10px] font-semibold text-[var(--brand-secondary-dark)] dark:text-[#20B2AA] bg-[var(--brand-secondary)]/20 px-2 py-0.5 rounded border border-[var(--brand-secondary)]/30">Maestro Klasik</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed font-normal">
            Pelantun & penyair musik Karo klasik dengan karya yang diwariskan lintas generasi.
          </p>
        </div>

        <div class="group glass-panel p-5 rounded-xl space-y-3 hover:border-[var(--brand-primary)]/50 hover:-translate-y-1 transition-all duration-200">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-[var(--brand-primary)] text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-sm group-hover:scale-105 transition-transform">
              PG
            </div>
            <div>
              <h4 class="font-bold text-[var(--text-main)] text-sm group-hover:text-[var(--brand-primary)] transition-colors font-['Outfit']">Plato Ginting</h4>
              <span class="text-[10px] font-semibold text-[var(--brand-secondary-dark)] dark:text-[#20B2AA] bg-[var(--brand-secondary)]/20 px-2 py-0.5 rounded border border-[var(--brand-secondary)]/30">Pop Modern</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed font-normal">
            Musisi generasi modern Karo yang mengombinasikan lirik khas dengan sentuhan akustik pop.
          </p>
        </div>

        <div class="group glass-panel p-5 rounded-xl space-y-3 hover:border-[var(--brand-primary)]/50 hover:-translate-y-1 transition-all duration-200">
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-[var(--brand-primary)] text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-sm group-hover:scale-105 transition-transform">
              RP
            </div>
            <div>
              <h4 class="font-bold text-[var(--text-main)] text-sm group-hover:text-[var(--brand-primary)] transition-colors font-['Outfit']">Ramona Purba</h4>
              <span class="text-[10px] font-semibold text-[var(--brand-secondary-dark)] dark:text-[#20B2AA] bg-[var(--brand-secondary)]/20 px-2 py-0.5 rounded border border-[var(--brand-secondary)]/30">Vokalis Utama</span>
            </div>
          </div>
          <p class="text-xs text-[var(--text-muted)] leading-relaxed font-normal">
            Penyanyi legendaris penyebarluas karya lagu daerah Karo ke panggung nasional.
          </p>
        </div>
      </div>
    </div>

  </section>

</Layout>
