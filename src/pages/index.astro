---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.astro';

const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_URL || 'https://api.lagukaro.id';

const pageParam = Astro.url.searchParams.get('page') || '1';

let songs: any[] = [];
let pagination = { page: 1, pageCount: 1 };

try {
  // Gunakan endpoint populate standar yang aman dari Strapi API
  const res = await fetch(`${STRAPI_URL}/api/lagus?populate=*&pagination[pageSize]=50&pagination[page]=${pageParam}`);
  if (!res.ok) {
    throw new Error(`API error: ${res.status} ${res.statusText}`);
  }
  const data = await res.json();
  songs = data.data || [];
  pagination = data.meta?.pagination || { page: 1, pageCount: 1 };
} catch (error) {
  console.error("Gagal mengambil data lagu dari Strapi API:", error);
}

// Helper ekstraksi nama penyanyi (Mendukung Many-to-Many penyanyis & fallback singular)
const getArtistNames = (song: any): string => {
  if (song?.penyanyis && Array.isArray(song.penyanyis) && song.penyanyis.length > 0) {
    return song.penyanyis.map((p: any) => p.name || p.nama).filter(Boolean).join(', ');
  }
  if (song?.penyanyi?.name) {
    return song.penyanyi.name;
  }
  return 'Artis Tidak Diketahui';
};

// Normalisasi views dari Strapi agar default ke 0 jika kosong
songs.forEach(song => {
  song.views = Number(song.views) || 0;
});

// Sortir manual di JavaScript agar aman meski views bernilai null/0
songs.sort((a, b) => (Number(b.views) || 0) - (Number(a.views) || 0));

// Helper teks aman dari String maupun Blocks
const getPlainText = (blocks: any): string => {
  if (!blocks) return '';
  if (typeof blocks === 'string') return blocks;
  if (Array.isArray(blocks)) {
    return blocks.map(block => {
      if (block?.children && Array.isArray(block.children)) {
        return block.children.map((child: any) => child?.text || '').join(' ');
      }
      return '';
    }).join(' ');
  }
  return '';
};

// Format tampilan angka views
const formatViews = (num: any) => {
  const count = Number(num) || 0;
  if (count >= 1000000) return (count / 1000000).toFixed(1) + 'M';
  if (count >= 1000) return (count / 1000).toFixed(1) + 'K';
  return count.toString();
};
---

<Layout title="Lagu Karo Trending & Lirik Terlengkap">
  
  <!-- HERO SECTION WITH AMBIENT WARM MESH GLOW (NO OVERFLOW-HIDDEN TO PREVENT SEARCH DROPDOWN CLIPPING) -->
  <section class="relative py-16 sm:py-20 px-4 sm:px-6">
    <!-- Ambient Floating Orbs (Warm Karo Red & Gold Glow) -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-red-900/15 blur-[130px] rounded-full pointer-events-none -z-10 animate-pulse"></div>
    <div class="absolute top-5 right-10 w-[300px] h-[300px] bg-amber-900/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

    <div class="max-w-4xl mx-auto text-center space-y-6 relative z-20">
      
      <!-- Cultural Subtle Badge with Ambient Glow -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-950/60 border border-red-700/30 text-red-300 text-xs font-semibold tracking-wide uppercase font-['Outfit'] shadow-[0_0_20px_rgba(185,28,28,0.2)]">
        <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
        Ensiklopedia Musik & Budaya Karo
      </div>

      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-white font-['Outfit'] leading-[1.15]">
        Temukan Lirik, Arti, & <br class="hidden sm:inline" />
        <span class="bg-clip-text text-transparent bg-gradient-to-r from-red-500 via-amber-400 to-amber-200">
          Makna Lagu Karo
        </span>
      </h1>

      <p class="text-neutral-400 text-sm sm:text-base max-w-xl mx-auto font-medium leading-relaxed">
        Pustaka lirik lagu daerah Karo terlengkap dan terpercaya. Dilengkapi dengan terjemahan bahasa Indonesia serta analisis makna lagu.
      </p>

      <!-- Live Search Bar Wrapper in Floating Glass Panel -->
      <div class="pt-4 max-w-2xl mx-auto relative z-30 text-left">
        <SearchBar />
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT CONTAINER -->
  <section id="trending" class="max-w-5xl mx-auto px-4 sm:px-6 py-8 space-y-12 relative z-10 scroll-mt-20">

    <!-- TRENDING SECTION HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between border-b border-white/10 pb-4 gap-3">
      <div class="space-y-1">
        <div class="flex items-center gap-2.5">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white uppercase font-['Outfit']">
            LAGU TRENDING
          </h2>
          <span class="text-[11px] font-bold bg-red-900/60 text-red-300 border border-red-700/40 px-2.5 py-0.5 rounded font-['Outfit'] tracking-wider uppercase">
            POPULER
          </span>
        </div>
        <p class="text-xs text-neutral-400 font-medium">Lagu Karo Paling Banyak Dicari & Didengar Saat Ini</p>
      </div>

      <div class="flex items-center gap-2 text-xs font-semibold text-neutral-400">
        <span class="px-3 py-1 rounded-lg bg-white/10 text-red-400 border border-red-800/30 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
          TRENDING SEKARANG
        </span>
      </div>
    </div>

    <!-- PROGRESSIVE TOP 10 TRENDING CARDS (Size scales down as rank descends) -->
    {songs.length > 0 ? (
      (() => {
        const top10 = songs.slice(0, 10);

        const getSongData = (song: any) => ({
          slug: song.slug || song.documentId,
          artist: getArtistNames(song),
          title: song.Title || song.title || 'Tanpa Judul',
          views: formatViews(song.views)
        });

        const getCardStyle = (rank: number) => {
          if (rank === 1) {
            return {
              padding: "p-4 sm:p-5",
              iconWrapper: "w-14 h-14 sm:w-16 sm:h-16 text-2xl sm:text-3xl rounded-xl",
              title: "text-lg sm:text-xl font-extrabold",
              artist: "text-sm sm:text-base font-semibold",
              hyphen: "text-sm font-bold",
              badge: "bg-gradient-to-r from-red-600 via-amber-600 to-amber-500 text-white font-extrabold text-xs px-2.5 py-0.5 shadow-md",
              viewsText: "text-xs",
              arrowBtn: "w-10 h-10",
              arrowIcon: "w-5 h-5",
              cardClass: "glass-panel-glow border-red-500/30 hover:border-red-500/50 hover:shadow-[0_20px_40px_rgba(185,28,28,0.25)] rounded-2xl"
            };
          }
          if (rank === 2) {
            return {
              padding: "py-3 px-3.5 sm:py-3.5 sm:px-4",
              iconWrapper: "w-12 h-12 sm:w-13 sm:h-13 text-xl rounded-xl",
              title: "text-base sm:text-lg font-bold",
              artist: "text-xs sm:text-sm font-semibold",
              hyphen: "text-xs font-semibold",
              badge: "bg-gradient-to-r from-red-700 via-amber-700 to-amber-600 text-white font-bold text-[11px] px-2 py-0.5 shadow-sm",
              viewsText: "text-[11px] sm:text-xs",
              arrowBtn: "w-8 h-8 sm:w-9 sm:h-9",
              arrowIcon: "w-4 h-4",
              cardClass: "glass-panel border-white/15 hover:border-red-600/40 rounded-xl"
            };
          }
          if (rank === 3) {
            return {
              padding: "py-2.5 px-3 sm:py-3 sm:px-4",
              iconWrapper: "w-10 h-10 sm:w-11 sm:h-11 text-lg rounded-lg",
              title: "text-sm sm:text-base font-bold",
              artist: "text-xs sm:text-sm font-semibold",
              hyphen: "text-xs font-medium",
              badge: "bg-gradient-to-r from-red-800 via-amber-800 to-amber-700 text-white font-bold text-[10px] sm:text-[11px] px-2 py-0.5 shadow-sm",
              viewsText: "text-[11px]",
              arrowBtn: "w-7 h-7 sm:w-8 sm:h-8",
              arrowIcon: "w-3.5 h-3.5",
              cardClass: "glass-panel border-white/10 hover:border-red-600/40 rounded-xl"
            };
          }
          if (rank <= 6) {
            return {
              padding: "py-2 px-3 sm:py-2.5 sm:px-3.5",
              iconWrapper: "w-8 h-8 sm:w-9 sm:h-9 text-base rounded-md",
              title: "text-xs sm:text-sm font-semibold",
              artist: "text-[11px] sm:text-xs font-medium",
              hyphen: "text-xs font-normal",
              badge: "bg-gradient-to-r from-red-900 to-amber-900/90 text-white/90 font-semibold text-[9px] sm:text-[10px] px-1.5 py-0.5 shadow-xs",
              viewsText: "text-[10px] sm:text-[11px]",
              arrowBtn: "w-6 h-6 sm:w-7 sm:h-7",
              arrowIcon: "w-3 h-3 sm:w-3.5 sm:h-3.5",
              cardClass: "bg-white/[0.03] border border-white/10 hover:border-red-600/30 hover:bg-white/[0.05] rounded-lg"
            };
          }
          // Rank 7 to 10
          return {
            padding: "py-1.5 px-2.5 sm:py-2 sm:px-3",
            iconWrapper: "w-6 h-6 sm:w-7 sm:h-7 text-xs rounded",
            title: "text-xs font-medium",
            artist: "text-[10px] sm:text-[11px] text-amber-400/80 font-normal",
            hyphen: "text-[10px]",
            badge: "bg-neutral-800/80 text-neutral-300 border border-neutral-700/40 font-medium text-[9px] px-1.5 py-0.2",
            viewsText: "text-[10px]",
            arrowBtn: "w-5 h-5 sm:w-6 sm:h-6",
            arrowIcon: "w-2.5 h-2.5 sm:w-3 sm:h-3",
            cardClass: "bg-white/[0.015] border border-white/5 hover:border-red-600/30 hover:bg-white/[0.035] rounded-md"
          };
        };

        return (
          <div class="space-y-1 mb-8">
            {top10.map((song, idx) => {
              const s = getSongData(song);
              const rankNum = idx + 1;
              const style = getCardStyle(rankNum);

              return (
                <div class="perspective-1000">
                  <a
                    href={`/lagu/${s.slug}`}
                    class={`group block relative ${style.cardClass} ${style.padding} transition-all duration-300 transform-style-3d hover:-translate-y-0.5`}
                  >
                    <div class="flex items-center justify-between gap-3">
                      <!-- Left: Artwork & Song Details -->
                      <div class="flex items-center gap-3 sm:gap-4 min-w-0 flex-1">
                        <div class={`${style.iconWrapper} bg-gradient-to-br from-red-700 to-amber-800 flex items-center justify-center text-white font-extrabold shadow-md flex-shrink-0 group-hover:scale-105 transition-transform duration-300`}>
                          🎵
                        </div>
                        <div class="space-y-0.5 min-w-0 flex-1">
                          <!-- Top row: Trending Badge + Views -->
                          <div class="flex items-center gap-2">
                            <span class={`inline-flex items-center gap-1 uppercase tracking-wide font-['Outfit'] rounded ${style.badge}`}>
                              🔥 TRENDING #{rankNum}
                            </span>
                            <span class={`${style.viewsText} text-neutral-400 font-medium flex items-center gap-1`}>
                              <svg class="w-3 h-3 text-red-500 inline flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                              </svg>
                              {s.views} Dilihat
                            </span>
                          </div>

                          <!-- Bottom row: Judul Lagu - Penyanyi (Horizontal) -->
                          <div class="flex flex-wrap sm:flex-nowrap items-baseline gap-x-2 gap-y-0.5 min-w-0">
                            <h3 class={`${style.title} text-white group-hover:text-red-400 transition-colors leading-snug truncate font-['Outfit']`}>
                              {s.title}
                            </h3>
                            <span class={`text-neutral-500 select-none ${style.hyphen}`}>-</span>
                            <p class={`${style.artist} text-amber-400 truncate`}>
                              {s.artist}
                            </p>
                          </div>
                        </div>
                      </div>

                      <!-- Right: Arrow hover indicator -->
                      <div class="flex items-center flex-shrink-0 pr-1">
                        <div class={`${style.arrowBtn} rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-neutral-400 group-hover:bg-red-600 group-hover:text-white group-hover:border-red-500 group-hover:translate-x-1 transition-all duration-300 shadow-sm`}>
                          <svg class={style.arrowIcon} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </div>
                      </div>
                    </div>
                  </a>
                </div>
              );
            })}
          </div>
        );
      })()
    ) : (
      <div class="py-12 text-center text-neutral-500 text-sm glass-panel rounded-xl">
        Belum ada lagu yang dipublikasikan di database.
      </div>
    )}

    <!-- SPOTLIGHT KOMPOSER & ARTIS POPULER KARO SECTION -->
    <div class="pt-10 border-t border-white/10">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div class="space-y-1">
          <span class="text-xs font-bold tracking-wider text-red-400 uppercase font-['Outfit']">SPOTLIGHT SENIMAN & KOMPOSER</span>
          <h3 class="text-xl sm:text-2xl font-extrabold text-white uppercase font-['Outfit']">Musisi & Legenda Karo</h3>
          <p class="text-xs text-neutral-400 max-w-md">Jelajahi karya komposer, penyanyi, dan maestro musik daerah Karo.</p>
        </div>
        <a
          href="/indeks-lagu"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-red-400 hover:text-red-300 font-['Outfit'] uppercase tracking-wide hover:translate-x-1 transition-all"
        >
          <span>Lihat Indeks Lagu (A-Z)</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div
          class="group glass-panel p-5 rounded-xl space-y-3 hover:border-red-700/50 hover:bg-[#181620] hover:-translate-y-1 transition-all duration-200"
        >
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-red-700 to-amber-700 text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-md group-hover:scale-105 transition-transform">
              DD
            </div>
            <div>
              <h4 class="font-bold text-white text-sm group-hover:text-red-400 transition-colors font-['Outfit']">Djaga Depari</h4>
              <span class="text-[10px] font-semibold text-red-400 bg-red-950/50 px-2 py-0.5 rounded border border-red-800/30">Legenda Komposer</span>
            </div>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed font-normal">
            Pencipta lagu-lagu legendaris Karo seperti Piso Surit, Erkata Bedil, dan Morah-Morah.
          </p>
        </div>

        <div
          class="group glass-panel p-5 rounded-xl space-y-3 hover:border-red-700/50 hover:bg-[#181620] hover:-translate-y-1 transition-all duration-200"
        >
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-red-700 to-amber-700 text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-md group-hover:scale-105 transition-transform">
              UG
            </div>
            <div>
              <h4 class="font-bold text-white text-sm group-hover:text-red-400 transition-colors font-['Outfit']">Usman Ginting</h4>
              <span class="text-[10px] font-semibold text-red-400 bg-red-950/50 px-2 py-0.5 rounded border border-red-800/30">Maestro Klasik</span>
            </div>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed font-normal">
            Pelantun & penyair musik Karo klasik dengan karya yang diwariskan lintas generasi.
          </p>
        </div>

        <div
          class="group glass-panel p-5 rounded-xl space-y-3 hover:border-red-700/50 hover:bg-[#181620] hover:-translate-y-1 transition-all duration-200"
        >
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-red-700 to-amber-700 text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-md group-hover:scale-105 transition-transform">
              PG
            </div>
            <div>
              <h4 class="font-bold text-white text-sm group-hover:text-red-400 transition-colors font-['Outfit']">Plato Ginting</h4>
              <span class="text-[10px] font-semibold text-red-400 bg-red-950/50 px-2 py-0.5 rounded border border-red-800/30">Pop Modern</span>
            </div>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed font-normal">
            Musisi generasi modern Karo yang mengombinasikan lirik khas dengan sentuhan akustik pop.
          </p>
        </div>

        <div
          class="group glass-panel p-5 rounded-xl space-y-3 hover:border-red-700/50 hover:bg-[#181620] hover:-translate-y-1 transition-all duration-200"
        >
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-red-700 to-amber-700 text-white font-extrabold text-lg flex items-center justify-center font-['Outfit'] shadow-md group-hover:scale-105 transition-transform">
              RP
            </div>
            <div>
              <h4 class="font-bold text-white text-sm group-hover:text-red-400 transition-colors font-['Outfit']">Ramona Purba</h4>
              <span class="text-[10px] font-semibold text-red-400 bg-red-950/50 px-2 py-0.5 rounded border border-red-800/30">Vokalis Utama</span>
            </div>
          </div>
          <p class="text-xs text-neutral-400 leading-relaxed font-normal">
            Penyanyi legendaris penyebarluas karya lagu daerah Karo ke panggung nasional.
          </p>
        </div>
      </div>
    </div>

  </section>

  <!-- GSAP CLIENT ANIMATION SCRIPT -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (typeof gsap !== 'undefined') {
        // Staggered Entrance Animation for Chart Songs
        gsap.from('.song-item', {
          duration: 0.5,
          y: 25,
          opacity: 0,
          stagger: 0.04,
          ease: 'power2.out',
          clearProps: 'all'
        });

        // Hero Spotlight Card Parallax 3D Tilt Effect
        const spotlightCard = document.querySelector('.transform-style-3d');
        if (spotlightCard) {
          spotlightCard.addEventListener('mousemove', (e) => {
            const rect = spotlightCard.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            gsap.to(spotlightCard, {
              rotateX: -y / 30,
              rotateY: x / 30,
              duration: 0.3,
              ease: 'power1.out'
            });
          });

          spotlightCard.addEventListener('mouseleave', () => {
            gsap.to(spotlightCard, {
              rotateX: 0,
              rotateY: 0,
              duration: 0.5,
              ease: 'power2.out'
            });
          });
        }
      }
    });
  </script>

</Layout>


