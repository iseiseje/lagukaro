---
import '../styles/global.css';
import PengeretRetFullWidth from '../components/PengeretRetFullWidth.astro';
import SEO from '../components/SEO.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  preventIndexing?: boolean;
  type?: 'website' | 'article' | 'music.song';
  schema?: Record<string, any>;
}

const { 
  title, 
  description,
  image,
  canonicalUrl,
  preventIndexing = false,
  type = "website",
  schema
} = Astro.props;
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Universal SEO Component (dapat di-override via slot="seo") -->
    <slot name="seo">
      <SEO
        title={title}
        description={description}
        image={image}
        canonicalUrl={canonicalUrl}
        preventIndexing={preventIndexing}
        type={type === 'music.song' ? 'music.song' : 'website'}
        schema={schema}
      />
    </slot>
    
    <!-- Google Fonts: Lora, Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Anti-FOUC Theme Initializer -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var supportDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && supportDark)) {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- GSAP & ScrollTrigger CDN -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- Slot for additional head tags (e.g. JSON-LD Schema) -->
    <slot name="head" />
  </head>
  <body class="bg-[var(--bg-base)] text-[var(--text-main)] min-h-screen font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[var(--brand-primary)] selection:text-white overflow-x-hidden transition-colors duration-200">
    <!-- Top Brand Navbar - Karo Cultural Clean Header -->
    <header class="border-b border-[var(--header-border)] bg-[var(--header-bg)] backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2.5">
          <div class="w-8 h-8 bg-[var(--brand-primary)] rounded-lg flex items-center justify-center text-white font-extrabold text-sm shadow-xs group-hover:scale-105 transition-transform duration-200 font-['Outfit']">
            GK
          </div>
          <span class="text-xl font-bold tracking-tight text-[var(--text-main)] uppercase font-['Outfit'] group-hover:text-[var(--brand-primary)] transition-colors">
            GENDANG<span class="text-[var(--brand-primary)]">KARO</span>
          </span>
        </a>

        <nav class="flex items-center space-x-1 sm:space-x-3">
          <a href="/indeks-lagu" class="px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-[var(--text-muted)] hover:text-[var(--brand-primary)] hover:bg-black/5 dark:hover:bg-white/5 transition-all">
            Indeks Lagu (A-Z)
          </a>
          <a href="/#trending" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-[var(--brand-primary)] hover:bg-[var(--brand-primary-hover)] text-white text-xs font-bold rounded-lg tracking-wide uppercase transition-all shadow-xs hover:scale-105">
            <span>🔥 Trending</span>
          </a>

          <!-- Theme Toggle Button (Light/Dark Mode) -->
          <button
            id="themeToggleBtn"
            type="button"
            aria-label="Ganti mode terang atau gelap"
            class="w-9 h-9 ml-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-main)] flex items-center justify-center hover:border-[var(--brand-primary)] hover:text-[var(--brand-primary)] transition-all cursor-pointer shadow-xs"
            title="Ganti Mode Tampilan"
          >
            <!-- Sun Icon (Shown in Dark Mode) -->
            <Icon name="heroicons:sun" class="w-4 h-4 hidden dark:block text-[var(--brand-accent)]" />
            <!-- Moon Icon (Shown in Light Mode) -->
            <Icon name="heroicons:moon" class="w-4 h-4 block dark:hidden text-[var(--text-main)]" />
          </button>
        </nav>
      </div>

      <!-- Pengeret-ret Cultural Scroll-Driven Animated Strip (Zero-JS) -->
      <PengeretRetFullWidth />
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="border-t border-[var(--border-color)] mt-24 py-10 bg-[var(--bg-surface)] text-center text-xs text-[var(--text-muted)] relative z-10 transition-colors duration-200">
      <div class="max-w-6xl mx-auto px-4 space-y-3">
        <div class="flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[var(--brand-primary)] animate-pulse"></span>
          <span class="font-['Outfit'] font-bold text-sm tracking-wider uppercase text-[var(--text-main)]">GENDANG KARO</span>
        </div>
        <p class="text-[var(--text-muted)] max-w-md mx-auto leading-relaxed">
          Pustaka & Arsip Lirik Lagu Daerah Karo Terlengkap dengan Terjemahan Bahasa Indonesia.
        </p>
        <p class="text-[var(--text-subtle)] pt-3">© 2026 Gendang Karo. Ensiklopedia Musik & Lirik Budaya Karo.</p>
      </div>
    </footer>

    <!-- Theme Toggle Handler Script -->
    <script is:inline>
      function initThemeToggle() {
        var toggle = document.getElementById('themeToggleBtn');
        if (!toggle) return;

        toggle.addEventListener('click', function() {
          var isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
            localStorage.setItem('theme', 'dark');
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeToggle);
      } else {
        initThemeToggle();
      }
    </script>
  </body>
</html>
