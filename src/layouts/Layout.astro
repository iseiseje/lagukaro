---
import '../styles/global.css';
import PengeretRetFullWidth from '../components/PengeretRetFullWidth.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article' | 'music.song';
}

const { 
  title, 
  description = "Pustaka lirik lagu daerah Karo terlengkap, terjemahan bahasa Indonesia, makna, dan chord gitar.",
  image = "/og-image.jpg",
  canonicalUrl,
  type = "website"
} = Astro.props;

const SITE_URL = import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString().replace(/\/$/, '') || 'https://lagukaro.id';
const resolvedCanonical = canonicalUrl 
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : `${SITE_URL}${canonicalUrl.startsWith('/') ? '' : '/'}${canonicalUrl}`)
  : `${SITE_URL}${Astro.url.pathname}`;

const resolvedImage = image.startsWith('http') 
  ? image 
  : `${SITE_URL}${image.startsWith('/') ? '' : '/'}${image}`;
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Gendang Karo</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical URL -->
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Open Graph / Facebook / WhatsApp (SMO) -->
    <meta property="og:site_name" content="Gendang Karo" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={`${title} | Gendang Karo`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter Card (SMO) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={`${title} | Gendang Karo`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />
    
    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Anti-FOUC Theme Initializer -->
    <script is:inline>
      (function() {
        try {
          var stored = localStorage.getItem('theme');
          var supportDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && supportDark)) {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
          } else {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          }
        } catch (e) {}
      })();
    </script>

    <!-- GSAP & ScrollTrigger CDN -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

    <!-- Slot for additional head tags (e.g. JSON-LD Schema) -->
    <slot name="head" />
  </head>
  <body class="bg-[var(--bg-base)] text-[var(--text-main)] min-h-screen font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-red-600 selection:text-white overflow-x-hidden transition-colors duration-200">
    <!-- Top Brand Navbar - Karo Cultural Clean Header -->
    <header class="border-b border-[var(--header-border)] bg-[var(--header-bg)] backdrop-blur-md sticky top-0 z-50 transition-colors duration-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2.5">
          <div class="w-8 h-8 bg-red-600 rounded-lg flex items-center justify-center text-white font-extrabold text-sm shadow-[0_0_12px_rgba(220,38,38,0.4)] group-hover:scale-105 transition-transform duration-200 font-['Outfit']">
            GK
          </div>
          <span class="text-xl font-bold tracking-tight text-[var(--text-main)] uppercase font-['Outfit'] group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">
            GENDANG<span class="text-red-600 dark:text-red-500">KARO</span>
          </span>
        </a>

        <nav class="flex items-center space-x-1 sm:space-x-3">
          <a href="/indeks-lagu" class="px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-black/5 dark:hover:bg-white/5 transition-all">
            Indeks Lagu (A-Z)
          </a>
          <a href="/#trending" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-lg tracking-wide uppercase transition-all shadow-sm hover:scale-105">
            <span>🔥 Trending</span>
          </a>

          <!-- Theme Toggle Button (Light/Dark Mode) -->
          <button
            id="themeToggleBtn"
            type="button"
            aria-label="Ganti mode terang atau gelap"
            class="w-9 h-9 ml-1 rounded-lg border border-[var(--border-color)] bg-[var(--bg-surface)] text-[var(--text-main)] flex items-center justify-center hover:border-red-600/50 hover:text-red-600 dark:hover:text-red-400 transition-all cursor-pointer shadow-xs"
            title="Ganti Mode Tampilan"
          >
            <!-- Sun Icon (Shown in Dark Mode) -->
            <svg class="w-4 h-4 hidden dark:block text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <!-- Moon Icon (Shown in Light Mode) -->
            <svg class="w-4 h-4 block dark:hidden text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </nav>
      </div>

      <!-- Pengeret-ret Cultural Scroll-Driven Animated Strip (Zero-JS) -->
      <PengeretRetFullWidth />
    </header>

    <main class="relative z-10">
      <slot />
    </main>

    <footer class="border-t border-[var(--border-color)] mt-24 py-10 bg-[var(--bg-surface)] text-center text-xs text-[var(--text-muted)] relative z-10 transition-colors duration-200">
      <div class="max-w-6xl mx-auto px-4 space-y-3">
        <div class="flex items-center justify-center gap-2">
          <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
          <span class="font-['Outfit'] font-bold text-sm tracking-wider uppercase text-[var(--text-main)]">GENDANG KARO</span>
        </div>
        <p class="text-[var(--text-muted)] max-w-md mx-auto leading-relaxed">
          Pustaka & Arsip Lirik Lagu Daerah Karo Terlengkap dengan Terjemahan Bahasa Indonesia.
        </p>
        <p class="text-[var(--text-subtle)] pt-3">© 2026 Gendang Karo. Ensiklopedia Musik & Lirik Budaya Karo.</p>
      </div>
    </footer>

    <!-- Theme Toggle Handler Script -->
    <script is:inline>
      function initThemeToggle() {
        var toggle = document.getElementById('themeToggleBtn');
        if (!toggle) return;

        toggle.addEventListener('click', function() {
          var isDark = document.documentElement.classList.contains('dark');
          if (isDark) {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.classList.add('dark');
            document.documentElement.classList.remove('light');
            localStorage.setItem('theme', 'dark');
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initThemeToggle);
      } else {
        initThemeToggle();
      }
    </script>
  </body>
</html>
